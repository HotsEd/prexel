# Prexel server configuration — example values. Copy to /etc/prexel/prexel.env
# in production (chmod 600). install.sh generates the secret values via
# `openssl rand -hex 32`.

# Runtime mode: production | development
PREXEL_ENV=production

# HTTPS listen port.
PREXEL_PORT=3000

# Where the SQLite DB, logs, and TLS material live.
PREXEL_DATA_DIR=/var/lib/prexel

# 32+ char random hex used to derive the AES-256 key for at-rest encryption
# (SSH keys, secrets, etc.). Rotating this value invalidates ALL stored
# ciphertexts — back up first.
PREXEL_SECRET_KEY=replace-me-with-openssl-rand-hex-32-output-aaaa

# 32+ char random hex used to sign JWTs (HS256). Rotating invalidates all
# outstanding access tokens and refresh tokens.
PREXEL_JWT_SECRET=replace-me-with-openssl-rand-hex-32-output-bbbb

# Public URL of this instance. Used for CORS and absolute links.
PREXEL_INSTANCE_URL=https://prexel.example.com

# Optional: pre-issued TLS cert/key. If unset, a self-signed cert is generated
# under $PREXEL_DATA_DIR/tls/ on first boot.
# PREXEL_TLS_CERT=/etc/prexel/tls/server.crt
# PREXEL_TLS_KEY=/etc/prexel/tls/server.key

# Optional GitHub App credentials (used by git_sources of type github_app).
# See docs/development.md for the registration walkthrough. When unset, the
# github_app source type is rejected with `github_app_not_configured` while
# ssh_key and token still work.
# PREXEL_GITHUB_APP_ID=
# PREXEL_GITHUB_APP_PRIVATE_KEY=
# PREXEL_GITHUB_APP_SLUG=
